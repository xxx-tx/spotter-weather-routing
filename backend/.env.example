# Local development only. Never commit a real API key.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TOMTOM_API_KEY=your-tomtom-api-key
ROUTES_RATE_PER_MINUTE=6/min
ROUTES_RATE_PER_DAY=80/day
DRF_NUM_PROXIES=0

# When behind a correctly configured HTTPS proxy, set these as needed:
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=true
# CSRF_TRUSTED_ORIGINS=https://your-api-domain.example